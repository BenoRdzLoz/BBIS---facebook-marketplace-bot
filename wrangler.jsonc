{
  "name": "bbis---facebook-marketplace-bot",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-03-24",
  "browser": {
    "binding": "BROWSER"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "triggers": {
    "crons": [
      "15 0 10 11 *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
